---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutIntro from '../components/AboutIntro.astro';
import AboutVisual from '../components/AboutVisual.astro';
import { formatDate, posts, tagHref, tagSlug } from '../lib/posts';

const featuredPost = posts[0];
const secondaryPosts = posts.slice(1, 3);
const archivePosts = posts;
const archiveTags = Array.from(
  archivePosts.reduce((map, post) => {
    post.tags.forEach((tag) => {
      const existing = map.get(tag) ?? 0;
      map.set(tag, existing + 1);
    });
    return map;
  }, new Map<string, number>()),
)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag]) => tag);
---

<BaseLayout fullBleed>
  <div class="view" id="homeView">
    <section class="section section-first" id="home" aria-labelledby="featuredTitle">
      <div class="shell">
        <div class="section-heading reveal">
          <div>
            <div class="section-kicker" data-i18n="featuredKicker">Featured Notes</div>
            <h2 id="featuredTitle" data-i18n="featuredTitle">Recent writing</h2>
          </div>
          <p data-i18n="featuredIntro">Difficult things begin with what is easy; great things begin with what is small.</p>
        </div>

        {featuredPost && (
          <div class="featured-grid">
            <article class="article-card large reveal">
              <div>
                <div class="card-meta">
                  {featuredPost.tags[0] ? <a class="tag" href={tagHref(featuredPost.tags[0])}>{featuredPost.tags[0]}</a> : <span class="tag">Note</span>}
                  <time datetime={featuredPost.date}>{formatDate(featuredPost.date)}</time>
                </div>
                <h3><a href={featuredPost.href}>{featuredPost.title}</a></h3>
                <p>Latest note from the current blog archive.</p>
              </div>
              <a class="read-more" href={featuredPost.href} aria-label={`Read ${featuredPost.title}`}>
                <span data-i18n="readArticle">Read article</span> <span>→</span>
              </a>
            </article>

            <div class="featured-stack">
              {secondaryPosts.map((post) => (
                <article class="article-card compact reveal">
                  <div class="card-meta">
                    {post.tags[0] ? <a class="tag" href={tagHref(post.tags[0])}>{post.tags[0]}</a> : <span class="tag">Note</span>}
                    <time datetime={post.date}>{formatDate(post.date)}</time>
                  </div>
                  <h3><a href={post.href}>{post.title}</a></h3>
                  <p>From the current archive.</p>
                  <a class="read-more" href={post.href}>
                    <span data-i18n="readArticle">Read article</span> <span>→</span>
                  </a>
                </article>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <section class="section" id="writing" aria-labelledby="writingTitle">
      <div class="shell">
        <div class="section-heading reveal">
          <div>
            <div class="section-kicker" data-i18n="archiveKicker">Writing Archive</div>
            <h2 id="writingTitle" data-i18n="archiveTitle">All notes</h2>
          </div>
          <div class="section-side">
            <a class="text-link" href="/blog-archive/">Full archive →</a>
          </div>
        </div>

        <div class="filter-bar reveal" role="group" aria-label="Filter posts">
          <button class="filter-button active" data-filter="all" data-i18n="filterAll">All</button>
          {archiveTags.map((tag) => (
            <button class="filter-button" data-filter={tagSlug(tag)}>{tag}</button>
          ))}
        </div>

        <div class="post-list" data-paginated-posts>
          {archivePosts.map((post) => (
            <a class="post-row reveal" href={post.href} data-tags={post.tags.map((tag) => tagSlug(tag)).join(' ')}>
              <time class="post-date" datetime={post.date}>{formatDate(post.date)}</time>
              <div>
                <div class="post-title">{post.title}</div>
                <div class="post-summary">{post.tags.length > 0 ? post.tags.join(' · ') : 'Engineering note'}</div>
              </div>
              <span class="post-type">{post.tags[0] ?? 'Note'}</span>
            </a>
          ))}
        </div>

        <nav class="pagination" aria-label="Post pagination" data-pagination hidden>
          <button class="pagination-button" type="button" data-page-prev data-i18n="paginationPrev">Previous</button>
          <span class="pagination-status" data-page-status></span>
          <button class="pagination-button" type="button" data-page-next data-i18n="paginationNext">Next</button>
        </nav>
      </div>
    </section>

    <section class="section" id="about" aria-labelledby="aboutTitle">
      <div class="shell">
        <div class="about-construction reveal">
          <AboutIntro headingLevel="h2" headingId="aboutTitle" />
          <AboutVisual />
        </div>
      </div>
    </section>
  </div>

  <div class="view photo-page" id="photographyView" hidden>
    <section class="photo-hero shell">
      <div class="reveal">
        <div class="eyebrow" data-i18n="photoEyebrow">Photography Journal</div>
        <h1 data-i18n="photoTitle">Light, distance,<br />and ordinary days.</h1>
        <p data-i18n="photoIntro">
          Photography is not proof of where I have been. It is a way to preserve
          the relationship between light, place, and a particular state of mind.
        </p>
      </div>

      <button class="button secondary back-home reveal" data-route="home">
        <span>←</span>
        <span data-i18n="backHome">Back to home</span>
      </button>
    </section>

    <div class="shell">
      <hr class="photo-divider" />

      <div class="photo-grid">
        <button class="photo-card reveal" data-title-en="Morning by the Bay" data-title-zh="滨海清晨" data-meta="Singapore · 06:42">
          <div class="photo-art">
            <svg viewBox="0 0 900 580" role="img" aria-label="Morning by the bay">
              <defs>
                <linearGradient id="p1sky" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#b8c5c6"/>
                  <stop offset="55%" stop-color="#dacfc0"/>
                  <stop offset="100%" stop-color="#9caeaa"/>
                </linearGradient>
              </defs>
              <rect width="900" height="580" fill="url(#p1sky)"/>
              <circle cx="650" cy="150" r="55" fill="#d27964" opacity=".85"/>
              <rect x="0" y="345" width="900" height="235" fill="#6e8e8b"/>
              <path d="M0 390 C190 360 300 415 470 385 C630 357 760 398 900 370" fill="none" stroke="#d5ded8" stroke-opacity=".48" stroke-width="7"/>
              <g fill="#4b5b5a">
                <rect x="90" y="270" width="70" height="82"/>
                <rect x="172" y="232" width="38" height="120"/>
                <rect x="225" y="292" width="82" height="60"/>
                <rect x="730" y="248" width="32" height="104"/>
                <rect x="775" y="285" width="70" height="67"/>
              </g>
            </svg>
          </div>
          <span class="photo-caption">
            <span><strong data-photo-title>Morning by the Bay</strong>Singapore</span>
            <span>06:42</span>
          </span>
        </button>

        <button class="photo-card reveal" data-title-en="After the Rain" data-title-zh="雨后组屋" data-meta="Tiong Bahru · 17:20">
          <div class="photo-art">
            <svg viewBox="0 0 700 580" role="img" aria-label="Housing blocks after rain">
              <defs>
                <linearGradient id="p2" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#9ea79d"/>
                  <stop offset="100%" stop-color="#4e5c54"/>
                </linearGradient>
              </defs>
              <rect width="700" height="580" fill="url(#p2)"/>
              <rect x="75" y="75" width="490" height="425" rx="4" fill="#d7d0c1"/>
              <rect x="112" y="112" width="416" height="330" fill="#b9b4aa"/>
              <g fill="#53645b">
                <rect x="140" y="140" width="62" height="44"/>
                <rect x="225" y="140" width="62" height="44"/>
                <rect x="310" y="140" width="62" height="44"/>
                <rect x="395" y="140" width="62" height="44"/>
                <rect x="140" y="214" width="62" height="44"/>
                <rect x="225" y="214" width="62" height="44"/>
                <rect x="310" y="214" width="62" height="44"/>
                <rect x="395" y="214" width="62" height="44"/>
                <rect x="140" y="288" width="62" height="44"/>
                <rect x="225" y="288" width="62" height="44"/>
                <rect x="310" y="288" width="62" height="44"/>
                <rect x="395" y="288" width="62" height="44"/>
              </g>
              <path d="M0 514 C210 474 395 540 700 490 L700 580 L0 580 Z" fill="#36483f"/>
              <g stroke="#eef1ed" stroke-opacity=".38">
                <line x1="35" y1="0" x2="0" y2="80"/>
                <line x1="145" y1="0" x2="60" y2="200"/>
                <line x1="300" y1="0" x2="220" y2="190"/>
                <line x1="500" y1="0" x2="430" y2="175"/>
                <line x1="690" y1="0" x2="620" y2="170"/>
              </g>
            </svg>
          </div>
          <span class="photo-caption">
            <span><strong data-photo-title>After the Rain</strong>Tiong Bahru</span>
            <span>17:20</span>
          </span>
        </button>

        <button class="photo-card reveal" data-title-en="The Last Train" data-title-zh="末班地铁" data-meta="Downtown Line · 23:48">
          <div class="photo-art">
            <svg viewBox="0 0 800 580" role="img" aria-label="The last train">
              <defs>
                <linearGradient id="p3" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#293438"/>
                  <stop offset="100%" stop-color="#111719"/>
                </linearGradient>
              </defs>
              <rect width="800" height="580" fill="url(#p3)"/>
              <rect x="85" y="80" width="630" height="420" rx="48" fill="#c8c6b9"/>
              <rect x="132" y="123" width="536" height="260" rx="12" fill="#405258"/>
              <rect x="170" y="150" width="215" height="205" fill="#1f2b30"/>
              <rect x="415" y="150" width="215" height="205" fill="#1f2b30"/>
              <rect x="165" y="415" width="470" height="28" rx="14" fill="#91665e"/>
              <circle cx="392" cy="111" r="9" fill="#c45f52"/>
              <rect x="260" y="470" width="280" height="18" rx="9" fill="#70756e"/>
              <path d="M0 525 L800 525 L800 580 L0 580 Z" fill="#0c1112"/>
            </svg>
          </div>
          <span class="photo-caption">
            <span><strong data-photo-title>The Last Train</strong>Downtown Line</span>
            <span>23:48</span>
          </span>
        </button>

        <button class="photo-card reveal" data-title-en="Afternoon by the Window" data-title-zh="窗边午后" data-meta="Home · 15:16">
          <div class="photo-art">
            <svg viewBox="0 0 700 580" role="img" aria-label="Afternoon by the window">
              <rect width="700" height="580" fill="#d9d3c4"/>
              <rect x="70" y="55" width="330" height="355" fill="#aabbb8"/>
              <line x1="235" y1="55" x2="235" y2="410" stroke="#e7e5dc" stroke-width="12"/>
              <line x1="70" y1="230" x2="400" y2="230" stroke="#e7e5dc" stroke-width="12"/>
              <path d="M430 0 L700 0 L700 580 L560 580 Z" fill="#c7b8a2"/>
              <rect x="0" y="425" width="700" height="155" fill="#8d6f56"/>
              <ellipse cx="365" cy="455" rx="150" ry="24" fill="#6e5644" opacity=".38"/>
              <rect x="300" y="330" width="105" height="95" rx="6" fill="#f0eee7"/>
              <path d="M405 350 C445 342 453 402 407 405" fill="none" stroke="#f0eee7" stroke-width="12"/>
              <rect x="480" y="280" width="62" height="145" rx="30" fill="#596b5c"/>
              <path d="M490 315 C442 258 460 212 500 250 C490 198 545 190 526 258 C575 222 596 270 540 320" fill="#667d68"/>
              <polygon points="70,55 400,55 590,425 300,425" fill="#fff4d6" opacity=".25"/>
            </svg>
          </div>
          <span class="photo-caption">
            <span><strong data-photo-title>Afternoon by the Window</strong>Home</span>
            <span>15:16</span>
          </span>
        </button>

        <button class="photo-card reveal" data-title-en="Running by the Sea" data-title-zh="海边跑步" data-meta="East Coast Park · 07:03">
          <div class="photo-art">
            <svg viewBox="0 0 900 580" role="img" aria-label="Running by the sea">
              <defs>
                <linearGradient id="p5" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#b6cad0"/>
                  <stop offset="70%" stop-color="#d7d0bb"/>
                </linearGradient>
              </defs>
              <rect width="900" height="580" fill="url(#p5)"/>
              <rect y="330" width="900" height="250" fill="#8aa6a5"/>
              <path d="M-50 580 L320 325 L610 325 L930 580 Z" fill="#b4aa90"/>
              <path d="M360 580 L470 325" stroke="#ede8d9" stroke-width="7"/>
              <path d="M620 580 L535 325" stroke="#ede8d9" stroke-width="7"/>
              <g stroke="#3d5548" stroke-width="14" stroke-linecap="round">
                <path d="M116 378 C125 270 150 175 167 92"/>
                <path d="M750 374 C730 258 716 176 703 105"/>
              </g>
              <g fill="#4e6756">
                <path d="M168 94 C95 85 70 132 126 141 C75 156 90 205 152 160 C135 216 187 217 182 154 C225 200 266 157 209 130 C267 117 252 72 184 111 C204 55 154 48 168 94"/>
                <path d="M704 105 C632 98 611 142 665 148 C610 166 631 209 690 164 C674 222 725 220 717 159 C761 201 803 161 744 134 C801 122 783 78 719 115 C739 58 690 58 704 105"/>
              </g>
              <circle cx="464" cy="358" r="12" fill="#8d5047"/>
              <path d="M464 370 L450 430 M464 388 L500 410 M463 392 L438 418 M450 430 L420 470 M450 430 L480 469" stroke="#314039" stroke-width="8" stroke-linecap="round"/>
            </svg>
          </div>
          <span class="photo-caption">
            <span><strong data-photo-title>Running by the Sea</strong>East Coast Park</span>
            <span>07:03</span>
          </span>
        </button>

        <button class="photo-card reveal" data-title-en="Hawker Centre at Night" data-title-zh="夜色食阁" data-meta="Maxwell · 20:31">
          <div class="photo-art">
            <svg viewBox="0 0 800 580" role="img" aria-label="Hawker centre at night">
              <rect width="800" height="580" fill="#1c2728"/>
              <rect x="45" y="108" width="710" height="382" rx="4" fill="#394546"/>
              <rect x="80" y="148" width="640" height="250" fill="#6e6656"/>
              <g fill="#e9c584">
                <rect x="105" y="175" width="120" height="70"/>
                <rect x="255" y="175" width="120" height="70"/>
                <rect x="405" y="175" width="120" height="70"/>
                <rect x="555" y="175" width="120" height="70"/>
              </g>
              <g fill="#c86f59">
                <circle cx="165" cy="312" r="35"/>
                <circle cx="330" cy="318" r="31"/>
                <circle cx="515" cy="310" r="34"/>
                <circle cx="640" cy="318" r="28"/>
              </g>
              <rect x="0" y="465" width="800" height="115" fill="#101718"/>
              <g fill="#d8b36f" opacity=".82">
                <circle cx="100" cy="70" r="9"/>
                <circle cx="238" cy="48" r="7"/>
                <circle cx="410" cy="77" r="10"/>
                <circle cx="582" cy="45" r="7"/>
                <circle cx="710" cy="78" r="8"/>
              </g>
            </svg>
          </div>
          <span class="photo-caption">
            <span><strong data-photo-title>Hawker Centre at Night</strong>Maxwell</span>
            <span>20:31</span>
          </span>
        </button>
      </div>
    </div>
  </div>
</BaseLayout>
