---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { BlogPost } from '../lib/posts';
import { formatDate, posts, tagHref } from '../lib/posts';

type Props = {
  post: BlogPost;
};

export const getStaticPaths = (() => {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props as Props;
const { Content } = post;
---

<BaseLayout title={post.title} description={`${post.title} by ${post.author}`} stickyNav={false}>
  <article>
    <header class="post-header">
      <p class="eyebrow">Article</p>
      <h1>{post.title}</h1>
      <div class="meta">{formatDate(post.date)} · {post.author}</div>
      {post.tags.length > 0 && (
        <div class="tags">
          {post.tags.map((tag: string) => <a class="tag" href={tagHref(tag)}>{tag}</a>)}
        </div>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
