---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects" description="Projects by Syuan">
  <section class="page-hero">
    <div>
      <p class="eyebrow">Projects</p>
      <h1>Selected Work</h1>
      <p>A quiet place for engineering projects, experiments, and notes. For now, the full archive lives on GitHub.</p>
      <div class="hero-actions">
        <a class="button primary" href="https://github.com/syuancheng">Visit GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
