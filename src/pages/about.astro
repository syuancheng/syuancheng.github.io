---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About Syuan">
  <section class="hero">
    <div>
      <p class="eyebrow">About</p>
      <h1>Syuan</h1>
      <p>Backend engineer writing notes about software engineering, computer science, and practical development experience.</p>
    </div>
  </section>

  <section class="about-grid">
    <img src="/static/img/profile.jpg" alt="Syuan profile photo" width="180" height="180" />
    <div class="prose">
      <p>Hi, I am Syuan. This site collects my technical notes and learning references.</p>
      <p>You can find me on <a href="https://github.com/syuancheng">GitHub</a>.</p>
    </div>
  </section>
</BaseLayout>
